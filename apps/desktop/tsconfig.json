{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@swyft/finance": ["../../packages/finance/src/index.ts"],
      "@swyft/contracts": ["../../packages/contracts/src/index.ts"],
      "@swyft/quoting": ["../../packages/quoting/src/index.ts"]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "vitest.integration.config.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ]
}
