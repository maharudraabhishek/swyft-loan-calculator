{
  "name": "@swyft/desktop",
  "productName": "Swyft Finance",
  "version": "1.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "electron-vite build",
    "package:win": "electron-vite build && electron-builder --win nsis --publish never",
    "package:mac": "electron-vite build && electron-builder --mac dmg --publish never",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@swyft/contracts": "workspace:*",
    "@swyft/finance": "workspace:*",
    "@swyft/quoting": "workspace:*",
    "decimal.js": "10.6.0",
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "30.1.1",
    "vite": "7.3.6"
  }
}
