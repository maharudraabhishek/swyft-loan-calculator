{
  "name": "@swyft/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "db"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "db:bootstrap": "tsx src/db-cli.ts bootstrap",
    "db:migrate": "tsx src/db-cli.ts migrate",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json vitest.config.ts vitest.db.config.ts",
    "lint": "eslint src test scripts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@google-cloud/storage": "8.2.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@swyft/contracts": "workspace:*",
    "@swyft/finance": "workspace:*",
    "@swyft/quoting": "workspace:*",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2"
  }
}
