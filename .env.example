# API configuration (copy to apps/api/.env for `pnpm api:dev`; .env files are git-ignored).
# Values below are placeholders. Never commit real passwords or keys.

NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info

# Externally visible origin of the API. Used to build the OAuth callback
# (<PUBLIC_BASE_URL>/v1/auth/callback). Must be https in production.
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Runtime database role (least privilege, subject to RLS).
# Cloud Run: DB_HOST=/cloudsql/<project>:<region>:<instance>, password from Secret Manager.
DB_HOST=127.0.0.1
DB_PORT=55432
DB_NAME=swyft
DB_USER=swyft_app
DB_PASSWORD=replace-with-the-password-you-chose-at-bootstrap
DB_POOL_MAX=5
DB_SSL=false

# identity-platform (Google via Identity Platform) or dev (local only; refused in production).
IDENTITY_PROVIDER=dev
# Required only for identity-platform; leave commented with dev (an empty value is rejected). The browser API key is an identifier, not a secret;
# restrict it to the Identity Toolkit API in the Google Cloud console.
# GCIP_API_KEY=<browser API key restricted to Identity Toolkit>
# GCIP_PROJECT_ID=<your-gcp-project-id>

# gcs (Cloud Storage, service identity) or memory (local only; refused in production).
LOGO_STORAGE=memory
# Required only with LOGO_STORAGE=gcs. Leave commented for local runs (an empty value is rejected).
# LOGO_BUCKET=<bucket-name>

# --- Operational commands only (never set on the API service) ---
# pnpm --filter @swyft/api db:bootstrap
#   ADMIN_DATABASE_URL=postgresql://postgres:<admin-password>@127.0.0.1:55432/postgres
#   SWYFT_DB_NAME=swyft SWYFT_OWNER_PASSWORD=<choose> SWYFT_APP_PASSWORD=<choose>
# pnpm --filter @swyft/api db:migrate
#   MIGRATION_DATABASE_URL=postgresql://swyft_owner:<owner-password>@127.0.0.1:55432/swyft

# Desktop build: public API origin embedded at build time (https in release builds).
# MAIN_VITE_API_BASE_URL=https://swyft-api-xxxxxxxx.a.run.app
